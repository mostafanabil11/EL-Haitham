# ---- Core ----
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/teaching-platform

# Comma-separated for multiple origins (production, custom domain, previews)
FRONTEND_URL=http://localhost:3001

# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ---- Admin bootstrap ----
# The single teacher account, seeded by `npm run bootstrap:admin`.
ADMIN_PHONE=
ADMIN_PASSWORD=

# ---- Video ----
# none | bunny | vimeo | youtube. Left as `none` until the provider is chosen;
# lectures still author and list, they just have no playback.
VIDEO_PROVIDER=none
VIDEO_TOKEN_TTL_MINUTES=240

BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_CDN_HOSTNAME=
BUNNY_TOKEN_KEY=

VIMEO_ACCESS_TOKEN=

# ---- Media storage (Cloudflare R2) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ---- Email (optional; students sign up with a phone, not an email) ----
BREVO_API_KEY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

EMAIL_USER=
EMAIL_PASSWORD=

# ---- Auth tuning ----
OTP_EXPIRATION_MINUTES=10
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MINUTES=15
